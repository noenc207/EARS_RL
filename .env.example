# EARS-RL Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env containing actual secrets to Git.

# --- Hardware Safety Mode ---
# Mandatory default: false
EARS_RL_HARDWARE_ENABLED=false

# --- Serial Communication (ESP32-S3 Hardware Bench) ---
EARS_RL_SERIAL_PORT=
EARS_RL_SERIAL_BAUDRATE=921600
EARS_RL_WATCHDOG_TIMEOUT_MS=500.0

# --- Directory Paths ---
EARS_RL_DATA_DIR=./datasets
EARS_RL_EXPERIMENTS_DIR=./experiments
EARS_RL_CHECKPOINTS_DIR=./checkpoints
EARS_RL_REPORTS_DIR=./reports

# --- Logging ---
EARS_RL_LOG_LEVEL=INFO

# --- AI Tooling & MCP API Keys (Optional) ---
# Context7 Upstash API Key (optional - leave blank for community tier)
CONTEXT7_API_KEY=

# GitHub Personal Access Token (optional - only needed when interacting with GitHub remote)
GITHUB_TOKEN=

# --- Isaac Lab (Optional Simulation Integration) ---
# EARS_RL_ISAAC_LAB_PATH=
